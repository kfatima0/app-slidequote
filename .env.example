# YQuo configuration.
#
# Copy to .env and fill in what you need. Nothing here is required to run the
# demo: with no variables set at all, every adapter is a mock, no network call
# leaves the process, and the full test suite passes. You add credentials to
# turn on one real provider at a time.
#
# Two prefixes, two purposes. YQUO_ADAPTERS__* and YQUO_POLICY__* are business
# policy; YQUO_TWILIO__*, YQUO_OPENAI__*, YQUO_COST__* and YQUO_OUTREACH__* are
# provider configuration and credentials. The double underscore is the nesting
# separator pydantic-settings uses; it is not a typo.


# ===========================================================================
# Which implementation of each port to use
#
# These are the switches the composition root reads. Everything defaults to a
# mock, so a fresh checkout runs.
# ===========================================================================

# mock | twilio. WhatsApp messaging AND phone calls: one switch, because both
# go through the same account and the same credentials.
YQUO_ADAPTERS__MESSAGING=mock

# mock | openai. Reading a professional's message, reading supplier quotes,
# and what the assistant says on a call. One switch: a deployment that reads
# quotes with a model but improvises phone calls from a regex is not a
# combination anyone means to choose.
YQUO_ADAPTERS__INTERPRETER=mock

# memory | supabase. Not built yet; see MIGRATION_PLAN.md §2.
YQUO_ADAPTERS__PERSISTENCE=memory

# keyword | pgvector. Not built yet; see MIGRATION_PLAN.md §4.
YQUO_ADAPTERS__MATCHER=keyword

# accelerated | system | manual
# The demo runs on an accelerated clock so a 30-minute confirmation window
# passes in half a minute. Production is `system`.
YQUO_ADAPTERS__CLOCK=accelerated
YQUO_DEMO__TIME_ACCELERATION=60


# ===========================================================================
# Twilio: WhatsApp and voice
#
# Needed only when YQUO_ADAPTERS__MESSAGING=twilio. The app refuses to start
# with real credentials present and signature validation off, so there is no
# way to accidentally deploy a webhook that accepts forged requests.
# ===========================================================================

YQUO_TWILIO__ACCOUNT_SID=
YQUO_TWILIO__AUTH_TOKEN=

# The WhatsApp sender, E.164 with the whatsapp: prefix. Until Meta approves a
# business sender (days to weeks) this is the Twilio sandbox number, and
# sandbox and production differ only in this value.
YQUO_TWILIO__WHATSAPP_FROM=whatsapp:+14155238886

# An ordinary voice number for outbound calls. It cannot be the same number as
# the WhatsApp sender; Twilio does not let one number do both.
YQUO_TWILIO__VOICE_FROM=

# The public URL Twilio can reach. A tunnel in development (ngrok, cloudflared).
# Webhook signatures are computed over the full URL, and it is rebuilt from this
# value rather than from the request host, because behind a tunnel or a proxy
# the Host header is not what Twilio saw. Get this wrong and every webhook 403s.
YQUO_TWILIO__PUBLIC_BASE_URL=https://your-tunnel.example.com

# Leave true. Off is for tests that build requests by hand.
YQUO_TWILIO__VALIDATE_SIGNATURES=true

# Optional. A messaging service gets you sender pools and centrally configured
# status callbacks; sending straight from a number works without one.
YQUO_TWILIO__MESSAGING_SERVICE_SID=


# ===========================================================================
# OpenAI: interpretation, extraction, and the voice agent
#
# Needed only when YQUO_ADAPTERS__INTERPRETER=openai.
# ===========================================================================

YQUO_OPENAI__API_KEY=

# Model names are configuration, not constants: they change faster than this
# codebase will, and pinning one in code means a redeploy to move off a
# deprecated snapshot.
YQUO_OPENAI__MODEL=gpt-5.6
YQUO_OPENAI__VISION_MODEL=gpt-5.6
YQUO_OPENAI__REALTIME_MODEL=gpt-realtime
YQUO_OPENAI__TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Rough prices per million tokens, in EUR, for the spend ledger. Estimates, not
# billing: they exist so a runaway job stops early. The real figure comes from
# the invoice, which is why the ledger stores token counts alongside the euros.
YQUO_OPENAI__INPUT_PRICE_PER_MTOK_EUR=2.50
YQUO_OPENAI__OUTPUT_PRICE_PER_MTOK_EUR=10.00

YQUO_OPENAI__REQUEST_TIMEOUT_S=60
YQUO_OPENAI__MAX_RETRIES=2


# ===========================================================================
# What one job may spend
#
# A canvassing round that phones six suppliers is perhaps thirty cents. Anything
# approaching two euro means something is looping, and stopping is cheaper than
# finding out from the invoice.
# ===========================================================================

YQUO_COST__CEILING_PER_ORDER_EUR=2.00

# Below this remaining budget nothing new is dispatched, but work already
# started finishes. A job that stops halfway through a phone call has paid for
# the call and learned nothing.
YQUO_COST__RESERVE_EUR=0.20


# ===========================================================================
# Follow-up policy
#
# Real-world seconds, always, in every environment. The accelerated clock is
# what makes a demo compress them; none of these numbers change for it.
# ===========================================================================

YQUO_OUTREACH__NUDGE_AFTER_S=14400     # 4 hours: a reminder on WhatsApp
YQUO_OUTREACH__CALL_AFTER_S=28800      # 8 hours: phone them
YQUO_OUTREACH__CLOSE_AFTER_S=86400     # 24 hours: rank without them

# Refused at startup unless these escalate in that order.
YQUO_OUTREACH__MAX_ATTEMPTS_PER_SUPPLIER=3

# Provider failure handling.
YQUO_OUTREACH__BACKOFF_BASE_S=2.0
YQUO_OUTREACH__BACKOFF_MAX_S=300.0
YQUO_OUTREACH__CIRCUIT_BREAKER_THRESHOLD=5
YQUO_OUTREACH__CIRCUIT_BREAKER_RESET_S=60.0

# Outbound sends per second, per provider. Twilio's WhatsApp default for a new
# sender is one per second, and bursting past it gets the sender throttled
# rather than the message delayed.
YQUO_OUTREACH__RATE_LIMIT_PER_S=1.0


# ===========================================================================
# Retention (GDPR)
#
# Deleting is a scheduled act, not an accident. Call recordings are the most
# sensitive artefact and the shortest-lived.
# ===========================================================================

YQUO_RETENTION__RECORDING_DAYS=30
YQUO_RETENTION__TRANSCRIPT_DAYS=365
YQUO_RETENTION__MESSAGE_DAYS=365

# The audit log is append-only by design, so deletion there is a reviewed
# exception rather than a retention sweep. Left unset on purpose.
# YQUO_RETENTION__AUDIT_DAYS=


# ===========================================================================
# Frontend
# ===========================================================================

# Empty in a production build: the backend serves the page, so /api/... resolves
# to the same origin and CORS never enters the picture. Only needed when the
# Astro dev server on 4321 talks to a backend on 8000.
# PUBLIC_API_BASE=http://127.0.0.1:8000
